DATABASE_URL=sqlite:///./tripmatch.db
ANTHROPIC_API_KEY=
# Only needed if your Console org returns "identity-linked API key" errors —
# find the workspace id at console.anthropic.com under Settings > Workspaces.
ANTHROPIC_WORKSPACE_ID=
TRIPMATCH_LLM_MODEL=claude-sonnet-5

# Flight research (Milestone 4) — get a test-mode key at duffel.com.
# Without this, POST /api/trips/{id}/flights returns 500 (no fake fallback:
# there's no honest substitute for real flight-search data).
DUFFEL_API_KEY=
DUFFEL_API_VERSION=v2
